{"rules": [{"id": "N1", "title": "Looks like a misspelt brand", "group": "name", "reason": "within 1-2 edits of a very popular site's name, a classic typosquat", "points": 25}, {"id": "N2", "title": "Contains a famous brand name", "group": "name", "reason": "the registered name embeds a well-known brand (brand + extra words)", "points": 15}, {"id": "N3", "title": "Brand in the subdomain, not the registered name", "group": "name", "reason": "e.g. brand.login.example-site.com: the real owner of the name is not the brand", "points": 25}, {"id": "N4", "title": "Credential/scam keywords in the name", "group": "name", "reason": "words such as login, verify, secure, wallet, claim, refund", "points": 10}, {"id": "N5", "title": "Several scam keywords", "group": "name", "reason": "two or more such words in one name", "points": 10}, {"id": "N6", "title": "Many hyphens", "group": "name", "reason": "three or more hyphens, typical of stuffed phishing names", "points": 8}, {"id": "N7", "title": "Mostly digits or machine-generated look", "group": "name", "reason": "high digit share, or very random-looking letters", "points": 8}, {"id": "N8", "title": "Punycode / look-alike characters", "group": "name", "reason": "internationalised name that can hide look-alike letters", "points": 10}, {"id": "N9", "title": "Frequently abused top-level domain", "group": "name", "reason": "TLDs that abuse trackers repeatedly list as popular with scammers", "points": 8}, {"id": "N10", "title": "Free hosting / shared platform", "group": "name", "reason": "anyone can create a site on this platform; registry age tells nothing", "points": 10}, {"id": "R1", "title": "Registered in the last 30 days", "group": "registry", "reason": "most phishing names are used within days of registration", "points": 30}, {"id": "R2", "title": "Registered in the last 90 days", "group": "registry", "reason": "young names are over-represented among phishing", "points": 15}, {"id": "R3", "title": "Registered in the last year", 